FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|outlet)"
    {
        type            calculated;
        value           uniform 0;
    }
    ".*_to_.*"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    axis
    {
        type            empty;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
