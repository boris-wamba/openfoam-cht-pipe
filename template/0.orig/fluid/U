FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (@@UB@@ 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (@@UB@@ 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    ".*_to_.*"
    {
        type            noSlip;
    }
    axis
    {
        type            empty;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
