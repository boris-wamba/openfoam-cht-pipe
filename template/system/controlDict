FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     chtMultiRegionFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         @@END_TIME@@;

deltaT          1e-5;
adjustTimeStep  yes;
maxCo           @@MAX_CO@@;
maxDi           10;
maxDeltaT       @@MAX_DT@@;

writeControl    adjustableRunTime;
writeInterval   @@WRITE_INTERVAL@@;
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
